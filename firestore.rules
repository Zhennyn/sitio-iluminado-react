rules_version = '2';

// Regras do Firestore do projeto sitio-iluminado.
// Cole este conteúdo em Firebase Console → Firestore → Regras → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // Administrador = usuário logado cujo e-mail é o ID de um documento em `admins`.
    // Os usuários (e-mail e senha) são criados só pelo console: o site não tem cadastro.
    function ehAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    // Cada pessoa só consegue conferir o próprio cadastro. A lista é editada apenas pelo console.
    match /admins/{email} {
      allow read: if request.auth != null && request.auth.token.email.lower() == email;
      allow write: if false;
    }

    // Datas ocupadas (imóvel + início + fim): o site público lê, só o painel grava.
    match /ocupacao/{id} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    // Dados do painel: somente administradores.
    match /{colecao}/{id} {
      allow read, write: if ehAdmin()
        && colecao in ['imoveis', 'clientes', 'reservas', 'bloqueios', 'despesas', 'repasses', 'config'];
    }
  }
}
